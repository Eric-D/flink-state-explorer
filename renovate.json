{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "schedule:weekly"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    { "matchManagers": ["cargo"], "matchUpdateTypes": ["minor", "patch"], "groupName": "cargo (non-major)" },
    { "matchManagers": ["github-actions"], "groupName": "github-actions" }
  ]
}
